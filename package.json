{
  "name": "bash-explainer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.8.0",
  "publisher": "shun-fujioka",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sf624/bash-explainer.git"
  },
  "homepage": "https://github.com/sf624/bash-explainer#readme",
  "bugs": {
    "url": "https://github.com/sf624/bash-explainer/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Education"
  ],
  "keywords": [
    "bash",
    "shell",
    "shellscript",
    "sh",
    "zsh",
    "dash",
    "posix",
    "explain",
    "learning",
    "regex",
    "sed",
    "awk",
    "jq",
    "yq",
    "dockerfile",
    "makefile",
    "github actions",
    "jenkins",
    "circleci",
    "azure pipelines",
    "offline"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onLanguage:shellscript",
    "onLanguage:dockerfile",
    "onLanguage:makefile",
    "onLanguage:yaml",
    "onLanguage:github-actions-workflow",
    "onLanguage:markdown",
    "onLanguage:json",
    "onLanguage:python",
    "onLanguage:groovy",
    "onLanguage:jenkinsfile",
    "onLanguage:bats"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bashExplainer.showAtCursor",
        "title": "%cmd.showAtCursor%",
        "category": "Bash Explainer"
      },
      {
        "command": "bashExplainer.openPanel",
        "title": "%cmd.openPanel%",
        "category": "Bash Explainer",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "bashExplainer.selectDisplayMode",
        "title": "%cmd.selectDisplayMode%",
        "category": "Bash Explainer"
      },
      {
        "command": "bashExplainer.openSettings",
        "title": "%cmd.openSettings%",
        "category": "Bash Explainer",
        "icon": "$(gear)"
      }
    ],
    "keybindings": [
      {
        "command": "bashExplainer.showAtCursor",
        "key": "ctrl+k ctrl+e",
        "mac": "cmd+k cmd+e",
        "when": "editorTextFocus && bashExplainer.hasShell"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bashExplainer.openPanel",
          "when": "bashExplainer.hasShell",
          "group": "navigation"
        },
        {
          "command": "bashExplainer.openSettings",
          "when": "activeWebviewPanelId == 'bashExplainer.panel'",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "bashExplainer.showAtCursor",
          "when": "bashExplainer.hasShell",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "Bash Explainer",
      "properties": {
        "bashExplainer.language": {
          "type": "string",
          "enum": [
            "auto",
            "ja",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "日本語",
            "English"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "bashExplainer.notes.idioms": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.notes.idioms%"
        },
        "bashExplainer.notes.pitfalls": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.notes.pitfalls%"
        },
        "bashExplainer.shell": {
          "type": "string",
          "enum": [
            "auto",
            "bash",
            "sh",
            "dash",
            "ash",
            "yash",
            "ksh",
            "mksh",
            "zsh"
          ],
          "enumDescriptions": [
            "%config.shell.auto%",
            "bash",
            "%config.shell.sh%",
            "dash",
            "busybox ash",
            "yash",
            "ksh93",
            "mksh",
            "zsh"
          ],
          "default": "auto",
          "markdownDescription": "%config.shell%"
        },
        "bashExplainer.bashVersion": {
          "type": "string",
          "enum": [
            "5.2",
            "5.3"
          ],
          "enumDescriptions": [
            "%config.bashVersion.5.2%",
            "%config.bashVersion.5.3%"
          ],
          "default": "5.2",
          "markdownDescription": "%config.bashVersion%"
        },
        "bashExplainer.yq.flavor": {
          "type": "string",
          "enum": [
            "auto",
            "mikefarah4",
            "kislyuk",
            "mikefarah3"
          ],
          "enumDescriptions": [
            "%config.yq.flavor.auto%",
            "mikefarah/yq v4",
            "%config.yq.flavor.kislyuk%",
            "mikefarah/yq v3"
          ],
          "default": "auto",
          "markdownDescription": "%config.yq.flavor%"
        },
        "bashExplainer.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.diagnostics.enabled%"
        },
        "bashExplainer.diagnostics.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [],
          "markdownDescription": "%config.diagnostics.ignore%"
        },
        "bashExplainer.diagnostics.embedded": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.diagnostics.embedded%"
        },
        "bashExplainer.diagnostics.pitfalls": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.diagnostics.pitfalls%"
        },
        "bashExplainer.examples.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.examples.enabled%"
        },
        "bashExplainer.examples.disabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "regex",
              "sed",
              "awk",
              "jq",
              "yq",
              "perl",
              "textFilters",
              "pipeline",
              "expansion",
              "printf",
              "glob",
              "test",
              "xargs",
              "read",
              "getopt",
              "gitLog",
              "date"
            ],
            "enumDescriptions": [
              "%config.examples.kind.regex%",
              "%config.examples.kind.sed%",
              "%config.examples.kind.awk%",
              "%config.examples.kind.jq%",
              "%config.examples.kind.yq%",
              "%config.examples.kind.perl%",
              "%config.examples.kind.textFilters%",
              "%config.examples.kind.pipeline%",
              "%config.examples.kind.expansion%",
              "%config.examples.kind.printf%",
              "%config.examples.kind.glob%",
              "%config.examples.kind.test%",
              "%config.examples.kind.xargs%",
              "%config.examples.kind.read%",
              "%config.examples.kind.getopt%",
              "%config.examples.kind.gitLog%",
              "%config.examples.kind.date%"
            ]
          },
          "uniqueItems": true,
          "default": [],
          "markdownDescription": "%config.examples.disabled%"
        },
        "bashExplainer.examples.placement": {
          "type": "string",
          "enum": [
            "first",
            "last",
            "bottom"
          ],
          "enumDescriptions": [
            "%config.examples.placement.first%",
            "%config.examples.placement.last%",
            "%config.examples.placement.bottom%"
          ],
          "default": "first",
          "description": "%config.examples.placement%"
        },
        "bashExplainer.examples.inHover": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.examples.inHover%"
        },
        "bashExplainer.hover.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.hover.enabled%"
        },
        "bashExplainer.hover.followCursor": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.hover.followCursor%"
        },
        "bashExplainer.hover.followDelay": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "description": "%config.hover.followDelay%"
        },
        "bashExplainer.hover.maxDepth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%config.hover.maxDepth%"
        },
        "bashExplainer.hints.names": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.hints.names%"
        },
        "bashExplainer.hints.deadCode": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.hints.deadCode%"
        },
        "bashExplainer.inline.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.inline.enabled%",
          "markdownDeprecationMessage": "%config.inline.deprecated%"
        },
        "bashExplainer.inline.maxLength": {
          "type": "number",
          "default": 120,
          "minimum": 20,
          "description": "%config.inline.maxLength%",
          "markdownDeprecationMessage": "%config.inline.deprecated%"
        },
        "bashExplainer.panel.autoOpen": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.panel.autoOpen%"
        },
        "bashExplainer.panel.animations": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.panel.animations%"
        },
        "bashExplainer.panel.colors": {
          "type": "string",
          "enum": [
            "classic",
            "theme",
            "themeLike"
          ],
          "markdownEnumDescriptions": [
            "%config.panel.colors.classic%",
            "%config.panel.colors.theme%",
            "%config.panel.colors.themeLike%"
          ],
          "default": "classic",
          "markdownDescription": "%config.panel.colors%"
        },
        "bashExplainer.highlight.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "language-overridable",
          "markdownDescription": "%config.highlight.enabled%"
        },
        "bashExplainer.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "shellscript"
          ],
          "description": "%config.languages%"
        },
        "bashExplainer.embedded.files": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "dockerfile",
              "makefile",
              "yaml",
              "packageJson",
              "markdown",
              "python",
              "jenkinsfile",
              "bats"
            ],
            "enumDescriptions": [
              "%config.embedded.files.dockerfile%",
              "%config.embedded.files.makefile%",
              "%config.embedded.files.yaml%",
              "%config.embedded.files.packageJson%",
              "%config.embedded.files.markdown%",
              "%config.embedded.files.python%",
              "%config.embedded.files.jenkinsfile%",
              "%config.embedded.files.bats%"
            ]
          },
          "uniqueItems": true,
          "default": [
            "dockerfile",
            "makefile",
            "yaml",
            "packageJson",
            "markdown",
            "python",
            "jenkinsfile",
            "bats"
          ],
          "markdownDescription": "%config.embedded.files%"
        },
        "bashExplainer.customCommands": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.customCommands%",
          "additionalProperties": {
            "type": "object",
            "required": [
              "summary"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "description": "What the command does."
              },
              "style": {
                "enum": [
                  "gnu",
                  "posix",
                  "single-dash"
                ],
                "description": "How options are written: gnu (the default: options may come after operands), posix (the first operand ends the options), single-dash (long options with one dash: -name value)."
              },
              "options": {
                "anyOf": [
                  {
                    "type": "array",
                    "description": "The options.",
                    "items": {
                      "type": "object",
                      "required": [
                        "names",
                        "description"
                      ],
                      "properties": {
                        "names": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Its names, such as [\"-o\", \"--output\"]."
                        },
                        "description": {
                          "type": "string"
                        },
                        "takesValue": {
                          "type": "boolean",
                          "description": "The option takes a value (-o file, -ofile, --output=file)."
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "deprecationMessage": "Write options as a list: [{ \"names\": [\"-o\", \"--output\"], \"description\": \"…\" }]. This shape is still read, and a later release drops it.",
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "required": [
                            "description"
                          ],
                          "properties": {
                            "description": {
                              "type": "string"
                            },
                            "takesValue": {
                              "type": "boolean"
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              "operands": {
                "type": "array",
                "description": "The words that are not options, in order.",
                "items": {
                  "type": "object",
                  "required": [
                    "description"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "repeat": {
                      "enum": [
                        "?",
                        "*",
                        "+"
                      ],
                      "description": "? optional, * any number, + one or more; absent: exactly one."
                    }
                  }
                }
              },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "deprecationMessage": "Use operands: [{ \"description\": \"…\", \"repeat\": \"*\" }]. This shape is still read, and a later release drops it."
              },
              "subcommands": {
                "type": "object",
                "description": "The subcommands, with the same fields.",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "summary"
                  ],
                  "properties": {
                    "summary": {
                      "type": "string",
                      "description": "What the command does."
                    },
                    "style": {
                      "enum": [
                        "gnu",
                        "posix",
                        "single-dash"
                      ],
                      "description": "How options are written: gnu (the default: options may come after operands), posix (the first operand ends the options), single-dash (long options with one dash: -name value)."
                    },
                    "options": {
                      "anyOf": [
                        {
                          "type": "array",
                          "description": "The options.",
                          "items": {
                            "type": "object",
                            "required": [
                              "names",
                              "description"
                            ],
                            "properties": {
                              "names": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "Its names, such as [\"-o\", \"--output\"]."
                              },
                              "description": {
                                "type": "string"
                              },
                              "takesValue": {
                                "type": "boolean",
                                "description": "The option takes a value (-o file, -ofile, --output=file)."
                              }
                            }
                          }
                        },
                        {
                          "type": "object",
                          "deprecationMessage": "Write options as a list: [{ \"names\": [\"-o\", \"--output\"], \"description\": \"…\" }]. This shape is still read, and a later release drops it.",
                          "additionalProperties": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "object",
                                "required": [
                                  "description"
                                ],
                                "properties": {
                                  "description": {
                                    "type": "string"
                                  },
                                  "takesValue": {
                                    "type": "boolean"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      ]
                    },
                    "operands": {
                      "type": "array",
                      "description": "The words that are not options, in order.",
                      "items": {
                        "type": "object",
                        "required": [
                          "description"
                        ],
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "repeat": {
                            "enum": [
                              "?",
                              "*",
                              "+"
                            ],
                            "description": "? optional, * any number, + one or more; absent: exactly one."
                          }
                        }
                      }
                    },
                    "arguments": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "deprecationMessage": "Use operands: [{ \"description\": \"…\", \"repeat\": \"*\" }]. This shape is still read, and a later release drops it."
                    },
                    "subcommands": {
                      "type": "object",
                      "description": "Its own subcommands, with the same fields.",
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "summary"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "shebang",
        "superType": "comment",
        "description": "%semanticTokenTypes.shebang%"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "exported",
        "description": "%semanticTokenModifiers.exported%"
      },
      {
        "id": "unquoted",
        "description": "%semanticTokenModifiers.unquoted%"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "shellscript",
        "scopes": {
          "comment": [
            "comment.line.number-sign.shell"
          ],
          "shebang": [
            "comment.line.number-sign.shell meta.shebang.shell"
          ],
          "keyword": [
            "keyword.control.shell"
          ],
          "function": [
            "entity.name.function.call.shell"
          ],
          "function.defaultLibrary": [
            "support.function.builtin.shell"
          ],
          "function.declaration": [
            "entity.name.function.shell"
          ],
          "parameter": [
            "constant.other.option.shell"
          ],
          "string": [
            "string.quoted.double.shell"
          ],
          "string.unquoted": [
            "string.unquoted.argument.shell"
          ],
          "variable": [
            "variable.other.normal.shell"
          ],
          "variable.modification": [
            "variable.other.assignment.shell"
          ],
          "operator": [
            "keyword.operator.pipe.shell"
          ],
          "number": [
            "constant.numeric.shell"
          ],
          "regexp": [
            "string.regexp.unquoted.shell"
          ],
          "macro": [
