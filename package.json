{
  "name": "bash-explain",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "shun-fujioka",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sf624/bash-explain.git"
  },
  "homepage": "https://github.com/sf624/bash-explain#readme",
  "bugs": {
    "url": "https://github.com/sf624/bash-explain/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Education"
  ],
  "keywords": [
    "bash",
    "shell",
    "explain",
    "shellscript",
    "learning"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:shellscript",
    "onLanguage:dockerfile",
    "onLanguage:makefile",
    "onLanguage:yaml",
    "onLanguage:github-actions-workflow",
    "onLanguage:markdown",
    "onLanguage:json",
    "onLanguage:python"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bashExplain.showAtCursor",
        "title": "%cmd.showAtCursor%",
        "category": "Bash Explain"
      },
      {
        "command": "bashExplain.openPanel",
        "title": "%cmd.openPanel%",
        "category": "Bash Explain",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "bashExplain.selectDisplayMode",
        "title": "%cmd.selectDisplayMode%",
        "category": "Bash Explain"
      },
      {
        "command": "bashExplain.openSettings",
        "title": "%cmd.openSettings%",
        "category": "Bash Explain",
        "icon": "$(gear)"
      }
    ],
    "keybindings": [
      {
        "command": "bashExplain.showAtCursor",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bashExplain.openPanel",
          "when": "bashExplain.hasShell",
          "group": "navigation"
        },
        {
          "command": "bashExplain.openSettings",
          "when": "activeWebviewPanelId == 'bashExplain.panel'",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "bashExplain.showAtCursor",
          "when": "bashExplain.hasShell",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "Bash Explain",
      "properties": {
        "bashExplain.language": {
          "type": "string",
          "enum": [
            "auto",
            "ja",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "日本語",
            "English"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "bashExplain.shell": {
          "type": "string",
          "enum": [
            "auto",
            "bash",
            "sh",
            "dash",
            "ash",
            "yash",
            "ksh",
            "mksh",
            "zsh"
          ],
          "enumDescriptions": [
            "%config.shell.auto%",
            "bash",
            "%config.shell.sh%",
            "dash",
            "busybox ash",
            "yash",
            "ksh93",
            "mksh",
            "zsh"
          ],
          "default": "auto",
          "markdownDescription": "%config.shell%"
        },
        "bashExplain.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.diagnostics.enabled%"
        },
        "bashExplain.examples.placement": {
          "type": "string",
          "enum": [
            "first",
            "last",
            "bottom"
          ],
          "enumDescriptions": [
            "%config.examples.placement.first%",
            "%config.examples.placement.last%",
            "%config.examples.placement.bottom%"
          ],
          "default": "first",
          "description": "%config.examples.placement%"
        },
        "bashExplain.hover.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.hover.enabled%"
        },
        "bashExplain.hover.followCursor": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.hover.followCursor%"
        },
        "bashExplain.hover.followDelay": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "description": "%config.hover.followDelay%"
        },
        "bashExplain.inline.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.inline.enabled%"
        },
        "bashExplain.inline.maxLength": {
          "type": "number",
          "default": 120,
          "minimum": 20,
          "description": "%config.inline.maxLength%"
        },
        "bashExplain.panel.autoOpen": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.panel.autoOpen%"
        },
        "bashExplain.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "shellscript"
          ],
          "description": "%config.languages%"
        },
        "bashExplain.embedded.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.embedded.enabled%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && mocha",
    "package": "node esbuild.mjs --production && vsce package"
  },
  "dependencies": {
    "tree-sitter-bash": "0.23.3",
    "web-tree-sitter": "0.22.6"
  },
  "devDependencies": {
    "@types/mocha": "10.0.6",
    "@types/node": "18.19.130",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "2.26.1",
    "esbuild": "0.21.5",
    "mocha": "10.4.0",
    "tsx": "4.15.7",
    "typescript": "5.4.5"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  }
}
