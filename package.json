{
  "name": "bash-explainer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.1",
  "publisher": "shun-fujioka",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sf624/bash-explainer.git"
  },
  "homepage": "https://github.com/sf624/bash-explainer#readme",
  "bugs": {
    "url": "https://github.com/sf624/bash-explainer/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Education"
  ],
  "keywords": [
    "bash",
    "shell",
    "shellscript",
    "sh",
    "zsh",
    "dash",
    "posix",
    "explain",
    "learning",
    "regex",
    "sed",
    "awk",
    "jq",
    "yq",
    "dockerfile",
    "makefile",
    "github actions",
    "offline"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onLanguage:shellscript",
    "onLanguage:dockerfile",
    "onLanguage:makefile",
    "onLanguage:yaml",
    "onLanguage:github-actions-workflow",
    "onLanguage:markdown",
    "onLanguage:json",
    "onLanguage:python"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bashExplainer.showAtCursor",
        "title": "%cmd.showAtCursor%",
        "category": "Bash Explainer"
      },
      {
        "command": "bashExplainer.openPanel",
        "title": "%cmd.openPanel%",
        "category": "Bash Explainer",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "bashExplainer.selectDisplayMode",
        "title": "%cmd.selectDisplayMode%",
        "category": "Bash Explainer"
      },
      {
        "command": "bashExplainer.openSettings",
        "title": "%cmd.openSettings%",
        "category": "Bash Explainer",
        "icon": "$(gear)"
      }
    ],
    "keybindings": [
      {
        "command": "bashExplainer.showAtCursor",
        "key": "ctrl+k ctrl+e",
        "mac": "cmd+k cmd+e",
        "when": "editorTextFocus && bashExplainer.hasShell"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bashExplainer.openPanel",
          "when": "bashExplainer.hasShell",
          "group": "navigation"
        },
        {
          "command": "bashExplainer.openSettings",
          "when": "activeWebviewPanelId == 'bashExplainer.panel'",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "bashExplainer.showAtCursor",
          "when": "bashExplainer.hasShell",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "Bash Explainer",
      "properties": {
        "bashExplainer.language": {
          "type": "string",
          "enum": [
            "auto",
            "ja",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "日本語",
            "English"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "bashExplainer.notes.idioms": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.notes.idioms%"
        },
        "bashExplainer.shell": {
          "type": "string",
          "enum": [
            "auto",
            "bash",
            "sh",
            "dash",
            "ash",
            "yash",
            "ksh",
            "mksh",
            "zsh"
          ],
          "enumDescriptions": [
            "%config.shell.auto%",
            "bash",
            "%config.shell.sh%",
            "dash",
            "busybox ash",
            "yash",
            "ksh93",
            "mksh",
            "zsh"
          ],
          "default": "auto",
          "markdownDescription": "%config.shell%"
        },
        "bashExplainer.yq.flavor": {
          "type": "string",
          "enum": [
            "auto",
            "mikefarah4",
            "kislyuk",
            "mikefarah3"
          ],
          "enumDescriptions": [
            "%config.yq.flavor.auto%",
            "mikefarah/yq v4",
            "%config.yq.flavor.kislyuk%",
            "mikefarah/yq v3"
          ],
          "default": "auto",
          "markdownDescription": "%config.yq.flavor%"
        },
        "bashExplainer.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.diagnostics.enabled%"
        },
        "bashExplainer.diagnostics.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [],
          "markdownDescription": "%config.diagnostics.ignore%"
        },
        "bashExplainer.diagnostics.embedded": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.diagnostics.embedded%"
        },
        "bashExplainer.examples.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.examples.enabled%"
        },
        "bashExplainer.examples.disabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "regex",
              "sed",
              "awk",
              "jq",
              "yq",
              "perl",
              "textFilters",
              "pipeline",
              "expansion",
              "printf",
              "glob",
              "test",
              "xargs",
              "read",
              "getopt",
              "gitLog"
            ],
            "enumDescriptions": [
              "%config.examples.kind.regex%",
              "%config.examples.kind.sed%",
              "%config.examples.kind.awk%",
              "%config.examples.kind.jq%",
              "%config.examples.kind.yq%",
              "%config.examples.kind.perl%",
              "%config.examples.kind.textFilters%",
              "%config.examples.kind.pipeline%",
              "%config.examples.kind.expansion%",
              "%config.examples.kind.printf%",
              "%config.examples.kind.glob%",
              "%config.examples.kind.test%",
              "%config.examples.kind.xargs%",
              "%config.examples.kind.read%",
              "%config.examples.kind.getopt%",
              "%config.examples.kind.gitLog%"
            ]
          },
          "uniqueItems": true,
          "default": [],
          "markdownDescription": "%config.examples.disabled%"
        },
        "bashExplainer.examples.placement": {
          "type": "string",
          "enum": [
            "first",
            "last",
            "bottom"
          ],
          "enumDescriptions": [
            "%config.examples.placement.first%",
            "%config.examples.placement.last%",
            "%config.examples.placement.bottom%"
          ],
          "default": "first",
          "description": "%config.examples.placement%"
        },
        "bashExplainer.examples.inHover": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.examples.inHover%"
        },
        "bashExplainer.hover.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.hover.enabled%"
        },
        "bashExplainer.hover.followCursor": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.hover.followCursor%"
        },
        "bashExplainer.hover.followDelay": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "description": "%config.hover.followDelay%"
        },
        "bashExplainer.hover.maxDepth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%config.hover.maxDepth%"
        },
        "bashExplainer.inline.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.inline.enabled%"
        },
        "bashExplainer.inline.maxLength": {
          "type": "number",
          "default": 120,
          "minimum": 20,
          "description": "%config.inline.maxLength%"
        },
        "bashExplainer.panel.autoOpen": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.panel.autoOpen%"
        },
        "bashExplainer.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "shellscript"
          ],
          "description": "%config.languages%"
        },
        "bashExplainer.embedded.files": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "dockerfile",
              "makefile",
              "yaml",
              "packageJson",
              "markdown",
              "python"
            ],
            "enumDescriptions": [
              "%config.embedded.files.dockerfile%",
              "%config.embedded.files.makefile%",
              "%config.embedded.files.yaml%",
              "%config.embedded.files.packageJson%",
              "%config.embedded.files.markdown%",
              "%config.embedded.files.python%"
            ]
          },
          "uniqueItems": true,
          "default": [
            "dockerfile",
            "makefile",
            "yaml",
            "packageJson",
            "markdown",
            "python"
          ],
          "markdownDescription": "%config.embedded.files%"
        },
        "bashExplainer.customCommands": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.customCommands%",
          "additionalProperties": {
            "type": "object",
            "required": [
              "summary"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "description": "What the command does."
              },
              "options": {
                "type": "object",
                "description": "Option (e.g. \"-n\" or \"-o|--output\") → description, or { \"description\", \"takesValue\" }.",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "description"
                      ],
                      "properties": {
                        "description": {
                          "type": "string"
                        },
                        "takesValue": {
                          "type": "boolean"
                        }
                      }
                    }
                  ]
                }
              },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Descriptions of the arguments in order; the last one repeats."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && tsc --noEmit -p web && mocha",
    "package": "node esbuild.mjs --production && vsce package",
    "build:web": "tsx scripts/build-web.ts",
    "notices": "tsx scripts/notices.ts",
    "test:integration": "node --import tsx integration/run.ts",
    "test:integration:web": "node --import tsx integration/run-web.ts",
    "images": "node scripts/capture-readme-images.mjs"
  },
  "dependencies": {
    "tree-sitter-bash": "0.23.3",
    "web-tree-sitter": "0.22.6"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@types/mocha": "10.0.10",
    "@types/node": "18.19.130",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/test-web": "0.0.81",
    "@vscode/vsce": "2.32.0",
    "esbuild": "0.28.2",
    "mocha": "11.8.0",
    "playwright-core": "1.64.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12",
    "diff": "8.0.4",
    "js-yaml": "4.3.2",
    "markdown-it": "14.3.3",
    "serialize-javascript": "7.1.2"
  }
}
