  {
    "manual": "3.3",
    "snippet": "f() { @PROBE:a@; }; g() { f; }; g | cat; h() { x=$(f); }; h",
    "facts": {
      "a": "sub"
    }
  },
  {
    "manual": "3.7.3",
    "snippet": "command @PROBE:a@; builtin eval '@PROBE:b@'; time @PROBE:c@ 2>/dev/null",
    "facts": {
      "a": "not-run",
      "b": "main",
      "c": "main",
      "stderr": "SCRIPT: line 1: __probe: command not found"
    }
  },
  {
    "manual": "3.3",
    "snippet": "f() { [ \"$1\" ] && return; @PROBE:b@; g; }; g() { @PROBE:a@; f x; }; echo | f",
    "note": "functions that call each other run where the first is called",
    "facts": {
      "b": "sub",
      "a": "sub"
    }
  },
  {
    "manual": "3.3",
    "snippet": "f() { [ \"$1\" ] && return; @PROBE:b@; g; }; g() { @PROBE:a@; f x; }; x=$(f); g",
    "facts": {
      "b": "sub",
      "a": "mixed"
    },
    "gaps": {
      "b": "`return` and the positional parameters are not followed: `f x` from g returns before the marker, so f runs it only in `$( )`; the model says it may also run where g is called"
    }
  },
  {
    "manual": "4.2",
    "snippet": "m() { @PROBE:a@; }; echo | m; eval m; n() { @PROBE:b@; }; x=$(builtin eval n)",
    "note": "a function called by eval runs where eval does",
    "facts": {
      "a": "mixed",
      "b": "sub"
    }
  },
  {
    "manual": "4.2",
    "snippet": "m() { @PROBE:a@; }; echo | m; trap m EXIT",
    "note": "a trap's action runs in the shell that set it",
    "facts": {
      "a": "mixed"
    }
  },
  {
    "manual": "3.3",
    "snippet": "p() { @PROBE:a@; }; echo | p; \"${1:-p}\"",
    "note": "a call the model does not see: the name is a word it does not resolve",
    "facts": {
      "a": "mixed"
    }
  },
  {
    "manual": "3.3",
    "snippet": "f() { @PROBE:a@; }; export -f f; bash -c f",
    "note": "a function called only by another shell",
    "gaps": {
      "a": "the calls in a string another shell runs are in that shell's model (4.13), not in the script's: the model says the function may run where it is defined"
    },
    "facts": {
      "a": "other-shell"
    }
  }
]
