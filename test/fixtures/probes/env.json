  },
  {
    "manual": "4.2",
    "snippet": "echo | eval '@PROBE:a@'; ( eval '@PROBE:b@' ); eval '@PROBE:c@' | cat",
    "facts": {
      "a": "sub",
      "b": "sub",
      "c": "sub"
    }
  },
  {
    "manual": "3.2.3",
    "snippet": "if [ -n \"$X\" ]; then shopt -s lastpipe; fi; echo | @PROBE:a@",
    "note": "lastpipe on some paths only",
    "facts": {
      "a": "sub"
    },
    "gaps": {
      "a": "the condition reads `$X`, from the environment: lastpipe is on on one path, so the model says the last stage may run in the shell"
    }
  },
  {
    "manual": "3.2.4",
    "snippet": "@PROBE:a@ && @PROBE:b@ & wait; @PROBE:c@ > >(@PROBE:d@)",
    "facts": {
