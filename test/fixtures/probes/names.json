  {
    "manual": "6.6",
    "snippet": "alias ll='ls -l'; alias if=echo; @PROBE@",
    "names": [
      "ll",
      "if"
    ],
    "note": "type -t reports an alias only where aliases are expanded: expand_aliases is off in a script, on in POSIX mode",
    "facts": {
      "1": {
        "ll": {
          "bash": "none",
          "posix": "alias"
        },
        "if": {
          "bash": "keyword",
          "posix": "alias"
        }
      }
    },
    "gaps": {
      "1 ll posix": "type -t looks at the aliases when it runs; the commands of the line that defines the alias were read before, so they do not use it (the model gives what a command there runs)",
      "1 if posix": "type -t looks up aliases before reserved words; the parser reads `if` as a keyword first (`alias if=echo; if x` is a syntax error), which is what the model gives"
    }
